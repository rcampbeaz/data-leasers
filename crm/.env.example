# Copy to .env.local (local) or .env (VPS). Never commit real values.
# Supabase project region: US. Personal data is stored in the US.

# Public project URL and anon key (safe for the browser; access is enforced by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server only. Used by the website form intake route. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Where the public website lives. Form submissions are accepted only from these origins.
PUBLIC_SITE_ORIGIN=https://dataleasers.com
CRM_ORIGIN=https://app.dataleasers.com

# Reminder emails (Resend). The sending domain must be verified in Resend first.
RESEND_API_KEY=YOUR-RESEND-API-KEY
REMINDER_FROM_EMAIL=reminders@dataleasers.com

# Shared secret for the scheduled reminder job. Generate a long random value.
CRON_SECRET=YOUR-LONG-RANDOM-SECRET

# Require an authenticator-app code before the CRM opens. Leave false until the
# admin account has enrolled, or that account locks itself out.
MFA_REQUIRED=false

# Optional booking link shown on a company page (Cal.com, Calendly, Google appointment page).
BOOKING_URL=

# Shared secret for POST /api/inbound/email, which turns a forwarded email into an
# activity on a company. Generate a long random value; send it as x-inbound-secret.
INBOUND_EMAIL_SECRET=YOUR-INBOUND-SECRET

# Agents (draft writing). Runs are separate from the CRM's own data and are switched
# on per day from the Agents page; nothing is ever sent without a person scheduling it.
OPENAI_API_KEY=YOUR-OPENAI-KEY
OPENAI_MODEL=gpt-4o-mini
# Optional. Any OpenAI-compatible endpoint (Groq, Google AI Studio, OpenRouter), so a free tier works
# without buying OpenAI credit. Blank means OpenAI.
OPENAI_BASE_URL=

# Marketing console publishing. One provider covers every channel, so the platform
# approvals live with the provider rather than on fresh OAuth apps here.
# Any provider that accepts { platform, text, media, scheduled_at } works; the console
# calls this URL with a bearer key on every post.
SOCIAL_API_URL=https://api.provider.example/v1/post
SOCIAL_API_KEY=YOUR-PROVIDER-KEY

# Companies House. Free API key from the developer hub; sent as the basic-auth username
# with an empty password. Powers the advanced search on the Import page. The register is
# published under the Open Government Licence, so the results may be stored.
COMPANIES_HOUSE_API_KEY=YOUR-COMPANIES-HOUSE-KEY


# Bounces and complaints arrive by webhook. In Resend, add an endpoint pointing at
# https://app.dataleasers.com/api/webhooks/resend, subscribe it to email.bounced and
# email.complained, and paste the signing secret (starts with whsec_) here. Without this the
# route answers 503 rather than accepting unverified events.
RESEND_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Outbound email. Use a separate sending subdomain for prospect mail (for example
# mail.dataleasers.com) so cold mail cannot damage the reputation of transaction email.
# POSTAL_ADDRESS is the sender's physical address: every market here requires one in
# commercial email, and the sender refuses to start without it.
OUTBOUND_FROM_EMAIL=Roderick Campbell <rod@mail.dataleasers.com>
POSTAL_ADDRESS=Data Leasers, LLC, YOUR STREET, YOUR CITY, YOUR STATE, YOUR ZIP

# Facebook Page publishing. Free and uncapped because the Page is yours: no aggregator and no app
# review, and a Page token taken from a long-lived User token does not expire. The deploy writes these
# two from repository secrets, so this file is only a reminder of their names. Never commit a token.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# Optional: pin a Graph API version. Defaults to v26.0.
FACEBOOK_API_VERSION=v26.0
