# Copy to .env.local (local) or .env (VPS). Never commit real values.
# Supabase project region: US. Personal data is stored in the US.

# Public project URL and anon key (safe for the browser; access is enforced by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server only. Used by the website form intake route. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Where the public website lives. Form submissions are accepted only from these origins.
PUBLIC_SITE_ORIGIN=https://dataleasers.com
CRM_ORIGIN=https://app.dataleasers.com

# Reminder emails (Resend). The sending domain must be verified in Resend first.
RESEND_API_KEY=YOUR-RESEND-API-KEY
REMINDER_FROM_EMAIL=reminders@dataleasers.com

# Shared secret for the scheduled reminder job. Generate a long random value.
CRON_SECRET=YOUR-LONG-RANDOM-SECRET

# Require an authenticator-app code before the CRM opens. Leave false until the
# admin account has enrolled, or that account locks itself out.
MFA_REQUIRED=false

# Optional booking link shown on a company page (Cal.com, Calendly, Google appointment page).
BOOKING_URL=

# Shared secret for POST /api/inbound/email, which turns a forwarded email into an
# activity on a company. Generate a long random value; send it as x-inbound-secret.
INBOUND_EMAIL_SECRET=YOUR-INBOUND-SECRET
