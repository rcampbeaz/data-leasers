<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="theme-color" content="#0F2A47">
{%- if analytics.searchConsoleVerification %}
<meta name="google-site-verification" content="{{ analytics.searchConsoleVerification }}">
{%- endif %}
<link rel="icon" href="logo-icon.svg" type="image/svg+xml">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="en_US">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ site.url }}/og-card.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="dataleasers — company data licensing for AI teams">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle or title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.url }}/og-card.png">

<link rel="preload" href="fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="brand-tokens.{{ site.assetVersion }}.css">
<link rel="stylesheet" href="site.{{ site.assetVersion }}.css">
{% include "partials/schema.njk" %}
{%- if analytics.provider == "ga4" and analytics.id %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ analytics.id }}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag("js",new Date());gtag("config","{{ analytics.id }}");</script>
{%- elif analytics.provider == "plausible" and analytics.id %}
<script defer data-domain="{{ analytics.id }}" src="https://plausible.io/js/script.js"></script>
{%- endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<a class="skip-link" href="#main">Skip to content</a>
<div class="announce">
  <div class="wrap announce-inner">
    <span>$50,000 or 6% referral fee <span class="announce-note">&middot; paid by the data buyer</span></span>
    <a href="refer.html">Terms &rarr;</a>
  </div>
</div>
{% include "partials/header.njk" %}

{{ content | safe }}

{% include "partials/footer.njk" %}
<div class="cta-bar">
  <a class="btn" href="contact.html"><span class="label-long">Request a call back</span><span class="label-short">Call back</span></a>
  <a class="btn btn-ghost" href="index.html#fit">Check my fit</a>
</div>
<script src="site.{{ site.assetVersion }}.js" defer></script>
{%- if inlineScript %}
{{ inlineScript | safe }}
{%- endif %}
</body>
</html>
