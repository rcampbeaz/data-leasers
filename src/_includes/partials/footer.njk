<footer class="site-footer">
  <h2 class="visually-hidden">Site footer</h2>
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img class="footer-logo" width="440" height="104" src="logo-reversed.svg?v={{ site.assetVersion }}" alt="DataLeasers">
      <p>Data Leasers, LLC, registered in Arizona, introduces operating companies to the data buyers and AI labs that license company data for AI.</p>
    </div>
    <div class="footer-col">
      <h3>Learn</h3>
      <ul>
{%- for item in site.footer.primary %}
        <li><a href="{{ item.href }}">{{ item.label }}</a></li>
{%- endfor %}
      </ul>
    </div>
    <div class="footer-col">
      <h3>Details</h3>
      <ul>
{%- for item in site.footer.secondary %}
        <li><a href="{{ item.href }}">{{ item.label }}</a></li>
{%- endfor %}
      </ul>
    </div>
    <div class="footer-col">
      <h3>Explore</h3>
      <ul>
{%- for item in site.footer.guides %}
        <li><a href="{{ item.href }}">{{ item.label }}</a></li>
{%- endfor %}
      </ul>
    </div>
  </div>
  <div class="wrap footer-legal">
    <p>Data Leasers, LLC &middot; registered in Arizona &middot; all rights reserved.</p>
    <p><a href="privacy.html">Privacy</a> &middot; <a href="consent.html">Consent</a> &middot; <a href="trust.html">How we handle your data</a></p>
  </div>
</footer>
