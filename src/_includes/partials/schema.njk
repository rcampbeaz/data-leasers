{%- set crumbLabel = title | replace(" | DataLeasers", "") -%}
{%- set org = site.url + "/#organization" -%}
{%- set person = site.url + "/about.html#person" -%}
{%- set pageType = schemaType or "WebPage" -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ org }}",
      "name": "Data Leasers, LLC",
      "legalName": "Data Leasers, LLC",
      "url": "{{ site.url }}/",
      "logo": { "@type": "ImageObject", "url": "{{ site.url }}/logo.svg" },
      "description": "Data Leasers, LLC introduces operating companies to the data buyers and AI labs that license company data for AI.",
      "address": { "@type": "PostalAddress", "addressRegion": "AZ", "addressCountry": "US" }{% if siteAuthor.enabled and siteAuthor.name %},
      "founder": { "@id": "{{ person }}" }{% endif %}
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": "DataLeasers",
      "publisher": { "@id": "{{ org }}" },
      "inLanguage": "en-US"
    },
    {
      "@type": "{{ pageType }}",
      "@id": "{{ canonical }}#webpage",
      "url": "{{ canonical }}",
      "name": {{ title | dump | safe }},
      "description": {{ description | dump | safe }},
      "isPartOf": { "@id": "{{ site.url }}/#website" },
      "about": { "@id": "{{ org }}" },{% if updated %}
      "dateModified": "{{ updated }}",{% endif %}
      "author": {% if siteAuthor.enabled and siteAuthor.name %}{ "@id": "{{ person }}" }{% else %}{ "@id": "{{ org }}" }{% endif %},
      "primaryImageOfPage": { "@type": "ImageObject", "url": "{{ site.url }}/og-card.png" },
      "inLanguage": "en-US"
    }{% if siteAuthor.enabled and siteAuthor.name %},
    {
      "@type": "Person",
      "@id": "{{ person }}",
      "name": {{ siteAuthor.name | dump | safe }},{% if siteAuthor.role %}
      "jobTitle": {{ siteAuthor.role | dump | safe }},{% endif %}{% if siteAuthor.bio %}
      "description": {{ siteAuthor.bio | dump | safe }},{% endif %}
      "url": "{{ site.url }}/about.html",{% if siteAuthor.photo %}
      "image": "{{ site.url }}/{{ siteAuthor.photo }}",{% endif %}
      "address": { "@type": "PostalAddress", "addressRegion": "AZ", "addressCountry": "US" },
      "worksFor": { "@id": "{{ org }}" }{% if siteAuthor.url %},
      "sameAs": [{{ siteAuthor.url | dump | safe }}]{% endif %}
    }{% endif %}{% if bodyClass != "home" and not noindex %},
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": {{ crumbLabel | dump | safe }}, "item": "{{ canonical }}" }
      ]
    }{% endif %}{% if bodyClass == "home" %},
    {
      "@type": "Service",
      "name": "Introductions to data buyers for company data licensing",
      "serviceType": "Company data licensing introductions",
      "provider": { "@id": "{{ org }}" },
      "areaServed": [
        { "@type": "Country", "name": "United States" },
        { "@type": "Country", "name": "Canada" },
        { "@type": "Country", "name": "United Kingdom" },
        { "@type": "Country", "name": "Australia" }
      ],
      "description": "DataLeasers introduces operating companies to the data buyers and AI labs that license company data for AI. The company keeps ownership and approves scope and terms in writing."
    }{% endif %}
  ]
}
</script>
