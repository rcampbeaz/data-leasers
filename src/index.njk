---
layout: layouts/base.njk
permalink: "/"
title: "DataLeasers: turn your data into a new revenue line"
description: "DataLeasers introduces operating companies to a data buyer that takes data licensing for AI forward. Request a call back to see whether your records fit."
canonical: "https://dataleasers.com/"
bodyClass: "home"
inlineScript: |
  <script>
    (function () {
      var form = document.getElementById('qualifier');
      var out = document.getElementById('q-result');
      var bar = document.getElementById('fit-bar');
      var count = document.getElementById('fit-count');
      if (!form) return;
      var names = ['q1', 'q2', 'q3', 'q4'];
      function sync() {
        var answered = names.filter(function (n) {
          return form.querySelector('input[name="' + n + '"]:checked');
        }).length;
        if (bar) bar.style.width = (answered / names.length * 100) + '%';
        if (count) count.textContent = answered + ' of ' + names.length + ' answered';
      }
      form.addEventListener('change', sync);
      sync();
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var values = names.map(function (n) {
          var c = form.querySelector('input[name="' + n + '"]:checked');
          return c ? c.value : null;
        });
        out.hidden = false;
        if (values.indexOf(null) !== -1) {
          out.className = 'q-result q-review';
          out.innerHTML = '<strong>One more step.</strong> Answer all four questions and the result will be useful.';
          return;
        }
        var fit = values.every(function (v) { return v === 'yes'; });
        if (fit) {
          out.className = 'q-result q-fit';
          out.innerHTML = '<strong>You may fit the data buyer&rsquo;s criteria.</strong> The records worth reviewing first are the ones AI teams look for: customer conversations, support tickets, document and proposal history, and sales notes. The next step is a short call to confirm what you hold and whether it can be licensed.<div class="q-result-actions"><a class="btn" href="contact.html">Request a call back</a><a class="btn btn-ghost" href="#buyer-view">See what a buyer sees</a></div>';
        } else {
          out.className = 'q-result q-review';
          out.innerHTML = '<strong>You may not fit yet.</strong> The data buyer&rsquo;s criteria are strict, so a call may not be the right next step. If you know a company that does fit, you can <a href="refer.html">refer it to us</a>.';
        }
        out.setAttribute('tabindex', '-1');
        out.focus();
      });
    })();
  </script>
---
<main id="main">
  <section class="hero hero-home">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <img class="hero-brand" src="logo-reversed.svg?v={{ site.assetVersion }}" alt="DataLeasers" width="440" height="104">
          <p class="kicker">Data licensing for AI</p>
          <h1>Your data may be <span class="hl">worth more</span> than you think.</h1>
          <p class="lead">The conversations, documents and tickets behind everyday work show AI how real work gets done. DataLeasers introduces companies to a data buyer that takes data licensing for AI forward. We start with a conversation about what you hold.</p>
          <div class="hero-actions">
            <a class="btn" href="contact.html">Request a call back</a>
            <a class="btn btn-ghost" href="#buyer-view">See what a buyer sees</a>
          </div>
          <p class="hero-note">A first call carries no commitment. Nothing moves without your approval.</p>
        </div>
        <div>
          <div class="doors">
            <a class="door" href="#fit">
              <span class="door-label">I have data to sell</span>
              <span class="door-text">Check whether your company may fit, then request a short call back.</span>
              <span class="door-cta">Check my fit &rarr;</span>
            </a>
            <a class="door" href="refer.html">
              <span class="door-label">I know a company that should</span>
              <span class="door-text">Introduce a company to us and see how referral terms work.</span>
              <span class="door-cta">Refer a company &rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  

  <div class="wrap ticker-wrap">
    <div class="ticker reveal">
      <div class="ticker-item"><span class="ticker-num">30+</span><span class="ticker-label">staff, or 10+ for professional firms</span></div>
      <div class="ticker-item"><span class="ticker-num">3+</span><span class="ticker-label">years of records still in your systems</span></div>
      <div class="ticker-item"><span class="ticker-num">5+</span><span class="ticker-label">systems holding the work</span></div>
      <div class="ticker-item"><span class="ticker-num">Half</span><span class="ticker-label">of staff or more U.S.-based</span></div>
    </div>
  </div>
  </section>

  <section class="trust-strip" aria-label="How your data is handled">
    <div class="wrap">
      <ul class="trust-list">
        <li class="trust-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="icons.svg#i-check"/></svg>
          <div><strong>You approve the deal</strong><span>Scope and terms, in writing, before anything moves.</span></div>
        </li>
        <li class="trust-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="icons.svg#i-shield"/></svg>
          <div><strong>Rights checked first</strong><span>The data buyer confirms data can be licensed before anything moves.</span></div>
        </li>
        <li class="trust-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="icons.svg#i-lock"/></svg>
          <div><strong>Personal data reviewed separately</strong><span>Removing names does not make data anonymous. The data buyer removes or transforms identifiers before delivery.</span></div>
        </li>
        <li class="trust-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="icons.svg#i-doccheck"/></svg>
          <div><strong>Terms in writing</strong><span>Scope and price are set in the agreement you sign.</span></div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="fit">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="kicker"><span class="kicker-num">01</span>Quick check</p>
        <h2>Four questions, about a minute.</h2>
        <p>These are the data buyer&rsquo;s published minimums, and the check follows them. The company also has to own the records in those systems. Nothing you enter here is stored &mdash; see our <a href="privacy.html">privacy policy</a>.</p>
      </div>
      <div class="fit-panel reveal">
        <div class="fit-progress" aria-hidden="true"><span id="fit-bar"></span></div>
        <p class="fit-count" id="fit-count">0 of 4 answered</p>
        <form class="qualifier" id="qualifier" novalidate>
          <fieldset>
            <legend>1. Does your company have at least 30 full-time U.S. office staff &mdash; or 10 for an accounting, finance or medical firm, 6 for a law firm?</legend>
            <label class="q-option"><input type="radio" name="q1" value="yes" required> Yes</label>
            <label class="q-option"><input type="radio" name="q1" value="no"> No</label>
          </fieldset>
          <fieldset>
            <legend>2. Has your company operated for at least 3 years, with those years of records still in your systems?</legend>
            <label class="q-option"><input type="radio" name="q2" value="yes"> Yes</label>
            <label class="q-option"><input type="radio" name="q2" value="no"> No</label>
          </fieldset>
          <fieldset>
            <legend>3. Does your business run on at least five systems, such as email, internal chat, file storage, CRM and one more?</legend>
            <label class="q-option"><input type="radio" name="q3" value="yes"> Yes</label>
            <label class="q-option"><input type="radio" name="q3" value="no"> No</label>
          </fieldset>
          <fieldset>
            <legend>4. Is more than half of your staff working from U.S. offices?</legend>
            <label class="q-option"><input type="radio" name="q4" value="yes"> Yes</label>
            <label class="q-option"><input type="radio" name="q4" value="no"> No</label>
          </fieldset>
          <p><button class="btn" type="submit">See my result</button></p>
        </form>
        <div class="q-result" id="q-result" role="status" aria-live="polite" hidden></div>
      </div>
    </div>
  </section>

