layout: layouts/base.njk
permalink: "/"
title: "Sell company data to AI buyers | DataLeasers"
description: "DataLeasers puts your company records in front of several AI data buyers, compares scope, term and price, and brings you terms worth signing."
canonical: "https://dataleasers.com/"
updated: "2026-11-10"
bodyClass: "home"
inlineScript: |
  <script>
    (function () {
      var form = document.getElementById('qualifier');
      var out = document.getElementById('q-result');
      var bar = document.getElementById('fit-bar');
      var count = document.getElementById('fit-count');
      if (!form) return;
      var names = ['q1', 'q2', 'q3', 'q4'];
      function sync() {
        var answered = names.filter(function (n) {
          return form.querySelector('input[name="' + n + '"]:checked');
        }).length;
        if (bar) bar.style.width = (answered / names.length * 100) + '%';
        if (count) count.textContent = answered + ' of ' + names.length + ' answered';
      }
      form.addEventListener('change', sync);
      sync();
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var values = names.map(function (n) {
          var c = form.querySelector('input[name="' + n + '"]:checked');
          return c ? c.value : null;
        });
        out.hidden = false;
        if (values.indexOf(null) !== -1) {
          out.className = 'q-result q-review';
          out.innerHTML = '<strong>One more step.</strong> Answer all four questions and the result will be useful.';
          return;
        }
        var fit = values.every(function (v) { return v === 'yes'; });
        if (fit) {
          out.className = 'q-result q-fit';
          out.innerHTML = '<strong>You may fit the buyers&rsquo; criteria.</strong> The records worth reviewing first are the ones AI teams look for: customer conversations, support tickets, document and proposal history, and sales notes. The next step is a short call to confirm what you hold and whether it can be licensed.<div class="q-result-actions"><a class="btn" href="contact.html">Tell us about your data</a><a class="btn btn-ghost" href="#buyer-view">See what a buyer sees</a></div>';
        } else {
          out.className = 'q-result q-review';
          out.innerHTML = '<strong>On these answers, a call would waste your time.</strong> The floors are published above and the buyer applies them as written, so there is nothing to negotiate on a call. The useful next step is a different one: if you work with a company that clears all four, <a href="refer.html">refer it to us</a> and we will take it from there.';
        }
        out.setAttribute('tabindex', '-1');
        out.focus();
      });
    })();
  </script>
