description: "dataleasers introduces companies to a data buyer that takes data licensing for AI forward. Book a call to learn more."
canonical: "https://dataleasers.com/"
bodyClass: "home"
inlineScript: |
  <script>
    (function () {
      var form = document.getElementById('qualifier');
      var out = document.getElementById('q-result');
      var bar = document.getElementById('fit-bar');
      var count = document.getElementById('fit-count');
      if (!form) return;
      var names = ['q1', 'q2', 'q3', 'q4'];
      function sync() {
        var answered = names.filter(function (n) {
          return form.querySelector('input[name="' + n + '"]:checked');
        }).length;
        if (bar) bar.style.width = (answered / names.length * 100) + '%';
        if (count) count.textContent = answered + ' of ' + names.length + ' answered';
      }
      form.addEventListener('change', sync);
      sync();
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var values = names.map(function (n) {
          var c = form.querySelector('input[name="' + n + '"]:checked');
          return c ? c.value : null;
        });
        out.hidden = false;
        if (values.indexOf(null) !== -1) {
          out.className = 'q-result q-review';
          out.innerHTML = '<strong>One more step.</strong> Answer all four questions and the result will be useful.';
          return;
        }
        var fit = values.every(function (v) { return v === 'yes'; });
        if (fit) {
          out.className = 'q-result q-fit';
          out.innerHTML = '<strong>You may fit the data buyer&rsquo;s criteria.</strong> The records worth reviewing first are the ones AI teams look for: customer conversations, support tickets, document and proposal history, and sales notes. The next step is a short call to confirm what you hold and whether it can be licensed.<div class="q-result-actions"><a class="btn" href="contact.html">Book a call</a><a class="btn btn-ghost" href="#buyer-view">See what a buyer sees</a></div>';
        } else {
          out.className = 'q-result q-review';
          out.innerHTML = '<strong>You may not fit yet.</strong> The data buyer&rsquo;s criteria are strict, so a call may not be the right next step. If you know a company that does fit, you can <a href="refer.html">refer it to us</a>.';
        }
        out.setAttribute('tabindex', '-1');
        out.focus();
      });
    })();
  </script>
